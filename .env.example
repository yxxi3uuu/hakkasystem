# 複製此檔案為 .env 並填入你的設定

# 資料庫（本機開發用 localhost:5433，Docker 內部用 db:5432）
DATABASE_URL=postgresql+asyncpg://user:hakka2026@localhost:5433/dbname?ssl=disable

# 客語 API
HKTRANS_API=https://hktrans.bronci.com.tw
HKTTS_API=https://hktts.bronci.com.tw
HAKKA_USERNAME=your_hakka_username
HAKKA_PASSWORD=your_hakka_password

# LLM 模型路徑（放在 data/ 資料夾下）
LLM_MODEL_PATH=data/qwen2.5-3b-instruct-q4_k_m.gguf

# Google Gemini API Key（從 https://aistudio.google.com/apikey 取得）
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# YOLO 設定
YOLO_CONF_THRESHOLD=0.8
GEMINI_MODE=always
GEMINI_REVIEW_CLASSES=wine glass, cup, bowl
